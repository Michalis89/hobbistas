  "scripts": {
    "start:web": "nx serve hobbistas-web --port=4200 --host=127.0.0.1 --proxy-config=hobbistas-web/proxy.conf.json",
    "start:api": "nx serve api --port=3000 --host=127.0.0.1 --inspect=false",
    "start": "concurrently -k \"npm run start:api\" \"npm run start:web\"",
    "build:web": "nx build hobbistas-web",
    "build:api": "nx build api",
    "build": "nx run-many --target=build --all",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "format": "nx format:write",
    "clean": "rimraf dist .nx/cache"
  },
