# ==============================================
# HOBBISTAS API - Environment Configuration
# ==============================================

# Application
NODE_ENV=development
PORT=3333
API_PREFIX=api

# Supabase Configuration
# Πάρε αυτά τα keys από το Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Configuration
# Χρησιμοποιείται για authentication - δημιούργησε ένα strong secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS Configuration
# Frontend URL για CORS
FRONTEND_URL=http://localhost:4200

# Upload Configuration
# Max file size σε bytes (10MB default)
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug

# Email Configuration (optional - για μελλοντική χρήση)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-password
# EMAIL_FROM=noreply@hobbistas.gr
